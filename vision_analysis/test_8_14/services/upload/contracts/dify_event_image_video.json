{
  "id": "dify_event_image_video",
  "label": "Dify 事件图片+视频+数据",
  "description": "同时把标准事件、算法字段、标注图片和视频以文件形式上传到 Dify",
  "adapter": "dify_workflow",
  "media": ["annotated_image", "video"],
  "mapping": [
    {"source": "event", "target": "event_json", "transform": "json_string", "required": true},
    {"source": "fields", "target": "fields_json", "transform": "json_string", "required": true},
    {
      "source": "media.annotated_image",
      "target": "image",
      "transform": "file",
      "file_mode": "single",
      "required": true
    },
    {
      "source": "media.video",
      "target": "video",
      "transform": "file",
      "file_mode": "single",
      "required": true
    }
  ]
}
