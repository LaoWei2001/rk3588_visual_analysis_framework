{
  "id": "jnu_alarm_upload",
  "label": "JNU报警上报",
  "adapter": "http_json",
  "media": ["annotated_image", "raw_image"],
  "request": {"method": "POST"},
  "mapping": [
    {"source": "constant",              "target": "source",      "value": "JNU", "type": "string"},
    {"source": "event.type",            "target": "eventType",   "required": false},
    {"source": "event.snap_time",       "target": "snapTime",    "required": true},
    {"source": "event.end_time",        "target": "endTime",     "required": true},
    {"source": "media.annotated_image", "target": "base64Data",  "transform": "base64", "required": true},
    {"source": "media.raw_image",       "target": "base64DataRaw", "transform": "base64", "required": false},
    {"source": "constant",              "target": "invadeFlag",  "value": 1, "type": "number", "required": false},
    {"source": "constant",              "target": "detResult",   "value": {}, "type": "json", "required": true}
  ],
  "success": {"http_status": [200]},
  "description": ""
}
