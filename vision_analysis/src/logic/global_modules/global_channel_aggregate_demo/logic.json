{
  "label": "示例：多通道变量聚合与上报",
  "report_templates": [
    "report_templates/http_channel_aggregate.json"
  ],
  "event_types": [
    {
      "id": "channel_aggregate_alarm",
      "label": "多通道聚合告警",
      "help": "画布连入通道或应用全部通道的公开变量满足组合条件时触发。"
    }
  ],
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "total_count_threshold": {
        "type": "integer",
        "title": "目标总数阈值",
        "minimum": 1,
        "maximum": 20000,
        "default": 3,
        "x-step": 1,
        "x-hot-reload": "preserve_state"
      },
      "require_local_alarm": {
        "type": "boolean",
        "title": "要求至少一路局部告警",
        "default": false,
        "x-hot-reload": "preserve_state"
      },
      "max_data_age_ms": {
        "type": "integer",
        "title": "通道变量最大年龄",
        "description": "超过该时间未更新的通道变量不参与本轮计算。",
        "minimum": 100,
        "maximum": 60000,
        "default": 2000,
        "x-unit": "毫秒",
        "x-step": 100,
        "x-hot-reload": "preserve_state"
      }
    }
  },
  "report_fields": [
    {"key": "valid_channel_count", "type": "number", "label": "有效通道数"},
    {"key": "alarm_channel_count", "type": "number", "label": "局部告警通道数"},
    {"key": "total_count", "type": "number", "label": "目标总数"}
  ],
  "business_fields": []
}
