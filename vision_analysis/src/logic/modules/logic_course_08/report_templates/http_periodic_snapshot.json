{
  "id": "logic_course_08.http_periodic_snapshot",
  "version": 1,
  "label": "HTTP 周期截图",
  "description": "课程 8 随附模板：用 multipart/form-data 上传当前通道标注图片",
  "owner_logic": "logic_course_08",
  "event_types": [
    "logic_course_08"
  ],
  "adapter": "http",
  "media": [
    "annotated_image"
  ],
  "request": {
    "method": "POST",
    "path": "/api/snapshots",
    "encoding": "multipart"
  },
  "mapping": [
    {
      "source": "event.type",
      "target": "eventType",
      "location": "form",
      "required": true
    },
    {
      "source": "event.snap_time",
      "target": "captureTime",
      "location": "form",
      "required": true
    },
    {
      "source": "source.channel_id",
      "target": "channelId",
      "location": "form",
      "type": "number",
      "required": true
    },
    {
      "source": "media.annotated_image",
      "target": "image",
      "location": "file",
      "transform": "file",
      "required": true
    }
  ],
  "success": {
    "http_status": [
      200,
      201,
      202
    ]
  }
}
