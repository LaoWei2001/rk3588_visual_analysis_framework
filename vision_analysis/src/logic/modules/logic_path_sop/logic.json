{
    "label": "目标路径/顺序/停留检测(SOP编排)",
    "event_types": [
        {
            "id": "sop_violation",
            "label": "SOP 违规",
            "help": "工序顺序、停留、耗时、循环或触发条件不符合要求。"
        },
        {
            "id": "sop_normal",
            "label": "SOP 正常完成",
            "help": "仅在流程启用正常结果上报且本轮合规完成时产生。"
        }
    ],
    "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "flow": {
                "type": "object",
                "title": "SOP流程",
                "description": "SOP子画布生成的完整结构化流程；步骤引用的zoneName必须与ROI名称一致",
                "default": {
                    "target_label": "",
                    "reset_sec": 5,
                    "end_mode": "leave",
                    "end_zone": "",
                    "end_dwell_sec": 0,
                    "total_min_sec": 0,
                    "total_max_sec": 0,
                    "trigger_mode": "auto",
                    "trigger_mandatory": false,
                    "report_normal": false,
                    "steps": [],
                    "edges": [],
                    "edge_limits": [],
                    "entries": [],
                    "exits": []
                },
                "x-hot-reload": "reset_state",
                "x-ui-hidden": true
            }
        }
    },
    "report_fields": [
        {
            "key": "current_zone",
            "type": "string",
            "label": "当前区域"
        },
        {
            "key": "progress",
            "type": "number",
            "label": "当前步骤序号"
        },
        {
            "key": "step_count",
            "type": "number",
            "label": "步骤总数"
        },
        {
            "key": "round_total_seconds",
            "type": "number",
            "label": "本轮总耗时(秒)"
        },
        {
            "key": "order_error",
            "type": "boolean",
            "label": "是否顺序错误"
        },
        {
            "key": "completed",
            "type": "boolean",
            "label": "是否完成"
        }
    ],
    "business_fields": [
        {
            "path": "schema_version",
            "type": "number",
            "label": "业务JSON版本",
            "required": true,
            "default_selected": true
        },
        {
            "path": "event_id",
            "type": "string",
            "label": "事件ID",
            "required": true,
            "default_selected": true,
            "help": "用于边缘端、Dify核验结果和PostgreSQL记录的一对一关联"
        },
        {
            "path": "channel_id",
            "type": "number",
            "label": "视频通道ID",
            "default_selected": true
        },
        {
            "path": "trigger_unix_ms",
            "type": "number",
            "label": "触发时间戳(毫秒)",
            "default_selected": true
        },
        {
            "path": "snap_time",
            "type": "string",
            "label": "触发时间文本",
            "default_selected": true
        },
        {
            "path": "end_time",
            "type": "string",
            "label": "工序结束时间",
            "default_selected": true
        },
        {
            "path": "event_type",
            "type": "string",
            "label": "业务事件类型",
            "required": true,
            "default_selected": true
        },
        {
            "path": "edge_verdict",
            "type": "string",
            "label": "边缘端初判结果",
            "required": true,
            "default_selected": true
        },
        {
            "path": "message",
            "type": "string",
            "label": "工序结果说明",
            "default_selected": true
        },
        {
            "path": "sop.target_label",
            "type": "string",
            "label": "检测目标类别",
            "default_selected": true
        },
        {
            "path": "sop.completed",
            "type": "boolean",
            "label": "是否完成",
            "default_selected": true
        },
        {
            "path": "sop.current_zone",
            "type": "string",
            "label": "结束时所在区域",
            "default_selected": true
        },
        {
            "path": "sop.progress",
            "type": "number",
            "label": "完成进度",
            "default_selected": true
        },
        {
            "path": "sop.step_count",
            "type": "number",
            "label": "工序步骤总数",
            "default_selected": true
        },
        {
            "path": "sop.round_total_seconds",
            "type": "number",
            "label": "本轮总耗时(秒)",
            "default_selected": true
        },
        {
            "path": "sop.end_mode",
            "type": "string",
            "label": "结束判定方式",
            "default_selected": true
        },
        {
            "path": "sop.end_zone",
            "type": "string",
            "label": "配置的终点区域",
            "default_selected": true
        },
        {
            "path": "sop.required_end_dwell_seconds",
            "type": "number",
            "label": "终点要求停留时间(秒)",
            "default_selected": true
        },
        {
            "path": "sop.actual_end_zone_stay_seconds",
            "type": "number",
            "label": "终点实际连续停留时间(秒)",
            "default_selected": true
        },
        {
            "path": "sop.configured_sequence",
            "type": "json",
            "label": "配置的工序区域序列",
            "default_selected": true
        },
        {
            "path": "sop.configured_edges",
            "type": "json",
            "label": "实际生效的全部路径边",
            "default_selected": true,
            "help": "包含普通边、分支、回边和自环，可与configured_sequence组合还原完整路径图"
        },
        {
            "path": "sop.configured_entry_steps",
            "type": "json",
            "label": "实际生效的入口步骤",
            "default_selected": true
        },
        {
            "path": "sop.configured_exit_steps",
            "type": "json",
            "label": "实际生效的出口步骤",
            "default_selected": true
        },
        {
            "path": "sop.zone_history",
            "type": "json",
            "label": "实际经历区域历史",
            "default_selected": true
        },
        {
            "path": "sop.configured_loop_edges",
            "type": "json",
            "label": "配置的循环边及次数范围",
            "default_selected": true,
            "help": "每项包含起止步骤/区域与次数上下限；上下限均为0表示任意次数"
        },
        {
            "path": "sop.actual_loop_counts",
            "type": "json",
            "label": "本轮各循环边实际次数",
            "default_selected": true,
            "help": "正常和违规结果均输出，每项含actual_count与within_range"
        },
        {
            "path": "alarm_type",
            "type": "json",
            "label": "正常/违规类型及专属明细",
            "default_selected": true,
            "help": "完整保留动态违规对象，例如顺序错误、停留不足、停留过长和总耗时异常"
        }
    ],
    "actions": [
        {
            "id": "start_new_run",
            "label": "开始新一轮",
            "style": "primary",
            "help": "适合人工干预后手动开始新工序，或调试时重置当前 SOP 轮次"
        },
        {
            "id": "sop_trigger",
            "label": "外部触发",
            "style": "primary",
            "help": "在「外部触发」模式下，发送此信号启动新一轮SOP检测。也可由扫码枪、PLC等外部设备通过API调用。"
        },
        {
            "id": "sop_end_trigger",
            "label": "结束触发",
            "style": "primary",
            "help": "在「外部触发」结束模式下，发送此信号结束当前SOP工序。也可由扫码枪、PLC等外部设备通过API调用。"
        },
        {
            "id": "infer_toggle",
            "label": "推理开关",
            "style": "default",
            "help": "系统级动作: 翻转本通道YOLO推理的启停状态。点击一次关闭, 再点一次开启, 画面始终正常显示。"
        }
    ]
}
