{
    "label": "目标路径/顺序/停留检测(SOP编排)",
    "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
    },
    "report_fields": [
        {
            "key": "current_zone",
            "type": "string",
            "label": "当前区域"
        },
        {
            "key": "progress",
            "type": "number",
            "label": "当前步骤序号"
        },
        {
            "key": "step_count",
            "type": "number",
            "label": "步骤总数"
        },
        {
            "key": "round_total_seconds",
            "type": "number",
            "label": "本轮总耗时(秒)"
        },
        {
            "key": "order_error",
            "type": "boolean",
            "label": "是否顺序错误"
        },
        {
            "key": "completed",
            "type": "boolean",
            "label": "是否完成"
        }
    ],
    "business_fields": [
        {
            "path": "schema_version",
            "type": "number",
            "label": "业务JSON版本",
            "required": true,
            "default_selected": true
        },
        {
            "path": "event_id",
            "type": "string",
            "label": "事件ID",
            "required": true,
            "default_selected": true,
            "help": "用于边缘端、Dify核验结果和PostgreSQL记录的一对一关联"
        },
        {
            "path": "channel_id",
            "type": "number",
            "label": "视频通道ID",
            "default_selected": true
        },
        {
            "path": "trigger_unix_ms",
            "type": "number",
            "label": "触发时间戳(毫秒)",
            "default_selected": true
        },
        {
            "path": "snap_time",
            "type": "string",
            "label": "触发时间文本",
            "default_selected": true
        },
        {
            "path": "end_time",
            "type": "string",
            "label": "工序结束时间",
            "default_selected": true
        },
        {
            "path": "event_type",
            "type": "string",
            "label": "业务事件类型",
            "required": true,
            "default_selected": true
        },
        {
            "path": "edge_verdict",
            "type": "string",
            "label": "边缘端初判结果",
            "required": true,
            "default_selected": true
        },
        {
            "path": "message",
            "type": "string",
            "label": "工序结果说明",
            "default_selected": true
        },
        {
            "path": "sop.target_label",
            "type": "string",
            "label": "检测目标类别",
            "default_selected": true
        },
        {
            "path": "sop.completed",
            "type": "boolean",
            "label": "是否完成",
            "default_selected": true
        },
        {
            "path": "sop.current_zone",
            "type": "string",
            "label": "结束时所在区域",
            "default_selected": true
        },
        {
            "path": "sop.progress",
            "type": "number",
            "label": "完成进度",
            "default_selected": true
        },
        {
            "path": "sop.step_count",
            "type": "number",
            "label": "工序步骤总数",
            "default_selected": true
        },
        {
            "path": "sop.round_total_seconds",
            "type": "number",
            "label": "本轮总耗时(秒)",
            "default_selected": true
        },
        {
            "path": "sop.end_mode",
            "type": "string",
            "label": "结束判定方式",
            "default_selected": true
        },
        {
            "path": "sop.end_zone",
            "type": "string",
            "label": "配置的终点区域",
            "default_selected": true
        },
        {
            "path": "sop.required_end_dwell_seconds",
            "type": "number",
            "label": "终点要求停留时间(秒)",
            "default_selected": true
        },
        {
            "path": "sop.actual_end_zone_stay_seconds",
            "type": "number",
            "label": "终点实际连续停留时间(秒)",
            "default_selected": true
        },
        {
            "path": "sop.configured_sequence",
            "type": "json",
            "label": "配置的工序区域序列",
            "default_selected": true
        },
        {
            "path": "sop.configured_graph_mode",
            "type": "string",
            "label": "路径图配置模式",
            "default_selected": true,
            "help": "explicit表示画布显式连线；linear_fallback表示未配置边时采用顺序线性链"
        },
        {
            "path": "sop.configured_edges",
            "type": "json",
            "label": "实际生效的全部路径边",
            "default_selected": true,
            "help": "包含普通边、分支、回边和自环，可与configured_sequence组合还原完整路径图"
        },
        {
            "path": "sop.configured_entry_steps",
            "type": "json",
            "label": "实际生效的入口步骤",
            "default_selected": true
        },
        {
            "path": "sop.configured_exit_steps",
            "type": "json",
            "label": "实际生效的出口步骤",
            "default_selected": true
        },
        {
            "path": "sop.zone_history",
            "type": "json",
            "label": "实际经历区域历史",
            "default_selected": true
        },
        {
            "path": "sop.configured_loop_edges",
            "type": "json",
            "label": "配置的循环边及次数范围",
            "default_selected": true,
            "help": "每项包含起止步骤/区域与次数上下限；上下限均为0表示任意次数"
        },
        {
            "path": "sop.actual_loop_counts",
            "type": "json",
            "label": "本轮各循环边实际次数",
            "default_selected": true,
            "help": "正常和违规结果均输出，每项含actual_count与within_range"
        },
        {
            "path": "alarm_type",
            "type": "json",
            "label": "正常/违规类型及专属明细",
            "default_selected": true,
            "help": "完整保留动态违规对象，例如顺序错误、停留不足、停留过长和总耗时异常"
        }
    ],
    "actions": [
        {
            "id": "start_new_run",
            "label": "开始新一轮",
            "style": "primary",
            "help": "适合人工干预后手动开始新工序，或调试时重置当前 SOP 轮次"
        },
        {
            "id": "sop_trigger",
            "label": "外部触发",
            "style": "primary",
            "help": "在「外部触发」模式下，发送此信号启动新一轮SOP检测。也可由扫码枪、PLC等外部设备通过API调用。"
        },
        {
            "id": "sop_end_trigger",
            "label": "结束触发",
            "style": "primary",
            "help": "在「外部触发」结束模式下，发送此信号结束当前SOP工序。也可由扫码枪、PLC等外部设备通过API调用。"
        },
        {
            "id": "infer_toggle",
            "label": "推理开关",
            "style": "default",
            "help": "系统级动作: 翻转本通道YOLO推理的启停状态。点击一次关闭, 再点一次开启, 画面始终正常显示。"
        }
    ],
    "params": [
        {
            "key": "path_sequence",
            "type": "string",
            "label": "设计路径(区域名,逗号分隔)",
            "default": "",
            "placeholder": "区域1,区域2,区域3",
            "help": "目标应依次经过的区域名; 每个名字必须与本通道一个 ROI 区域名完全一致。顺序即期望经过顺序。一般由「SOP 路径编排」画布自动生成"
        },
        {
            "key": "path_target_label",
            "type": "string",
            "label": "目标类别名",
            "default": "",
            "placeholder": "person",
            "help": "要跟踪的目标类别(labels.txt 里的类名); 取整帧该类置信度最高的一个为目标"
        },
        {
            "key": "path_enter_sec",
            "type": "float",
            "label": "进入确认·默认(秒)",
            "default": 0.5,
            "min": 0,
            "max": 10,
            "help": "进入区域确认时长的【默认】值; 每步可在「SOP 路径编排」画布里单独配置(path_enter_list), 单独配置优先。0=立即进入"
        },
        {
            "key": "path_dwell_min_sec",
            "type": "float",
            "label": "最小停留·默认(秒)",
            "default": 0.0,
            "min": 0,
            "max": 600,
            "help": "每区域最小停留的【默认】值; 每步可在「SOP 路径编排」画布里单独配置(path_dwell_list), 单独配置优先。0=不要求"
        },
        {
            "key": "path_reset_sec",
            "type": "float",
            "label": "离场复位(秒)",
            "default": 5.0,
            "min": 0,
            "max": 600,
            "help": "目标离场(画面里检测不到)超过此秒数即清空本轮、重新开始一轮路径检测"
        },
        {
            "key": "path_end_dwell_sec",
            "type": "float",
            "label": "终点停留阈值(秒)",
            "default": 0.0,
            "min": 0,
            "max": 600,
            "help": "结束方式为终点区域时，目标必须在终点区域连续停留达到该时长才结束；中途离开会重新计时。0=通过进入确认后立即结束"
        }
    ]
}
