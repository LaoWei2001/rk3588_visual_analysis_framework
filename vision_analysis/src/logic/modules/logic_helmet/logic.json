{
    "label": "安全帽与中心圆人员违规检测",
    "event_types": [
        {
            "id": "helmet_missing",
            "label": "未佩戴安全帽告警",
            "help": "划定的ROI内出现类别0人员，且没有匹配到类别1安全帽时触发。"
        },
        {
            "id": "center_circle_person",
            "label": "中心圆人员告警",
            "help": "类别0人员的检测框中心进入画面中心圆形区域时触发，与是否佩戴安全帽无关。"
        }
    ],
    "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "roi_name": {
                "type": "string",
                "title": "安全帽检测ROI名称",
                "description": "留空表示使用本通道画出的全部ROI并集；填写后只使用同名ROI。未配置或找不到ROI时暂停安全帽违规检测。",
                "default": ""
            },
            "circle_radius": {
                "type": "integer",
                "title": "中心圆半径",
                "description": "以模型输入画面中心为圆心的检测半径，单位为模型坐标系像素。",
                "default": 150,
                "minimum": 1,
                "maximum": 2000
            },
            "person_min_score": {
                "type": "number",
                "title": "人员最低置信度",
                "description": "类别0检测结果低于该值时忽略。",
                "default": 0.0,
                "minimum": 0.0,
                "maximum": 1.0
            },
            "helmet_min_score": {
                "type": "number",
                "title": "安全帽最低置信度",
                "description": "类别1检测结果低于该值时不参与佩戴匹配。",
                "default": 0.0,
                "minimum": 0.0,
                "maximum": 1.0
            },
            "head_region_ratio": {
                "type": "number",
                "title": "人员头部区域高度比例",
                "description": "从人员框顶部向下取该比例作为安全帽匹配区域。",
                "default": 0.4,
                "minimum": 0.1,
                "maximum": 1.0
            },
            "helmet_match_margin_ratio": {
                "type": "number",
                "title": "安全帽匹配边缘扩展比例",
                "description": "向人员框顶部和左右扩展的比例，用于容忍安全帽框略微超出人员框。",
                "default": 0.12,
                "minimum": 0.0,
                "maximum": 0.5
            },
            "rearm_seconds": {
                "type": "number",
                "title": "告警复位时间",
                "description": "违规消失并持续该秒数后允许同类违规再次上报；连续违规期间只上报一次。",
                "default": 1.0,
                "minimum": 0.0,
                "maximum": 3600.0
            }
        }
    },
    "report_fields": [
        {"key": "person_class_id", "type": "number", "label": "人员类别编号"},
        {"key": "helmet_class_id", "type": "number", "label": "安全帽类别编号"},
        {"key": "roi_name", "type": "string", "label": "安全帽检测ROI"},
        {"key": "roi_person_count", "type": "number", "label": "ROI内人员数量"},
        {"key": "unhelmeted_person_count", "type": "number", "label": "未佩戴安全帽人数"},
        {"key": "unhelmeted_track_ids", "type": "json", "label": "未佩戴安全帽人员跟踪ID"},
        {"key": "circle_center_x", "type": "number", "label": "中心圆圆心X"},
        {"key": "circle_center_y", "type": "number", "label": "中心圆圆心Y"},
        {"key": "circle_radius", "type": "number", "label": "中心圆半径"},
        {"key": "circle_person_count", "type": "number", "label": "中心圆内人员数量"},
        {"key": "circle_person_track_ids", "type": "json", "label": "中心圆内人员跟踪ID"}
    ]
}
