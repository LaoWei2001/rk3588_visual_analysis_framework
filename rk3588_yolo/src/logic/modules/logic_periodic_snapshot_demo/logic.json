{
    "label": "周期截图与热重载演示",
    "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "report_interval_sec": {
                "type": "integer",
                "title": "参数1：截图上报间隔",
                "description": "每隔多少秒创建一条独立截图事件。修改后会清空该逻辑的计时状态，并从新的完整间隔重新计时。",
                "minimum": 1,
                "maximum": 86400,
                "default": 10,
                "x-step": 1,
                "x-unit": "秒",
                "x-hot-reload": "reset_state"
            },
            "display_number": {
                "type": "integer",
                "title": "参数2：右上角显示数字",
                "description": "显示在实时画面右上角；Web 保存新值后，下一次业务帧立即显示新数字，不重置截图计时。",
                "minimum": -999999999,
                "maximum": 999999999,
                "default": 100,
                "x-step": 1,
                "x-hot-reload": "preserve_state"
            }
        }
    },
    "report_fields": [
        {
            "key": "display_number",
            "type": "number",
            "label": "截图时显示数字"
        },
        {
            "key": "report_interval_sec",
            "type": "number",
            "label": "截图上报间隔（秒）"
        },
        {
            "key": "report_sequence",
            "type": "number",
            "label": "本次状态周期事件序号"
        }
    ]
}
