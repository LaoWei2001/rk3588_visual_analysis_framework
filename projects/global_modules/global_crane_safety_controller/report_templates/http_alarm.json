{
  "version": 1,
  "label": "JNU 行车安全拼接图片告警",
  "description": "以 application/json 上传行车安全告警字段、四通道标注拼接图和原始拼接图 Base64。",
  "owner_logic": "global_crane_safety_controller",
  "event_types": [
    "crane_hook_outside",
    "crane_moving_intrusion",
    "crane_still_no_helmet"
  ],
  "adapter": "http",
  "media": [
    "annotated_image",
    "raw_image"
  ],
  "request": {
    "method": "POST",
    "path": "/api/objectInvadeDet",
    "encoding": "json"
  },
  "mapping": [
    {
      "source": "constant",
      "target": "source",
      "location": "body",
      "value": "JNU",
      "type": "string",
      "required": true
    },
    {
      "source": "event.type",
      "target": "eventType",
      "location": "body",
      "required": true
    },
    {
      "source": "event.id",
      "target": "eventId",
      "location": "body",
      "required": true
    },
    {
      "source": "event.message",
      "target": "message",
      "location": "body",
      "required": true
    },
    {
      "source": "event.snap_time",
      "target": "snapTime",
      "location": "body",
      "required": true
    },
    {
      "source": "event.end_time",
      "target": "endTime",
      "location": "body",
      "required": true
    },
    {
      "source": "source.channel_id",
      "target": "channelId",
      "location": "body",
      "type": "number",
      "required": true
    },
    {
      "source": "media.annotated_image",
      "target": "base64Data",
      "location": "body",
      "transform": "base64",
      "required": true
    },
    {
      "source": "media.raw_image",
      "target": "base64DataRaw",
      "location": "body",
      "transform": "base64",
      "required": true
    },
    {
      "source": "constant",
      "target": "invadeFlag",
      "location": "body",
      "value": 1,
      "type": "number",
      "required": true
    },
    {
      "source": "constant",
      "target": "yuvWidth",
      "location": "body",
      "value": 1280,
      "type": "number",
      "required": true
    },
    {
      "source": "constant",
      "target": "yuvHeight",
      "location": "body",
      "value": 720,
      "type": "number",
      "required": true
    },
    {
      "source": "constant",
      "target": "yuvFlag",
      "location": "body",
      "value": "video",
      "type": "string",
      "required": true
    },
    {
      "source": "fields.crane_moving",
      "target": "craneMoving",
      "location": "body",
      "type": "boolean",
      "required": true
    },
    {
      "source": "fields.hook_visible",
      "target": "hookVisible",
      "location": "body",
      "type": "boolean",
      "required": false
    },
    {
      "source": "fields.hook_distance",
      "target": "hookDistance",
      "location": "body",
      "type": "number",
      "required": false
    },
    {
      "source": "fields.person_count",
      "target": "personCount",
      "location": "body",
      "type": "number",
      "required": false
    },
    {
      "source": "fields.unhelmeted_count",
      "target": "unhelmetedCount",
      "location": "body",
      "type": "number",
      "required": false
    }
  ],
  "success": {
    "http_status": [
      200
    ],
    "json_path": "code",
    "equals": 200
  }
}
