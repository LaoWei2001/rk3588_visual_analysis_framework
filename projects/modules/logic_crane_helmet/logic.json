{
  "label": "行车静止安全帽检测",
  "event_types": [],
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "alarm_mode": { "type": "string", "title": "安全帽告警判断方式", "default": "missing_helmet", "enum": ["bare_head", "missing_helmet"], "x-hot-reload": "reset_state", "description": "综合模式（missing_helmet）：人员匹配到裸头时不受宽高阈值限制；未匹配裸头或安全帽时，人员框宽度和高度都达到各自阈值才计为违规。裸头模式（bare_head）：只以匹配到裸头作为违规依据。两种模式都沿用违规确认和解除时间。" },
      "roi_name": { "type": "string", "title": "装卸区域ROI名称", "default": "loading_zone", "x-hot-reload": "reset_state" },
      "person_labels": { "type": "string", "title": "人员标签", "default": "person", "x-hot-reload": "reset_state" },
      "helmet_labels": { "type": "string", "title": "安全帽标签", "default": "helmet", "x-hot-reload": "reset_state" },
      "bare_head_labels": { "type": "string", "title": "未戴帽头部标签", "default": "bare_head", "x-hot-reload": "reset_state", "description": "与模型类别表中的实际名称一致，多个标签用逗号分隔。匹配到同帧人员时优先作为违规证据，不受人员宽高阈值或附近安全帽框影响。" },
      "person_min_score": { "type": "number", "title": "人员最低置信度", "default": 0.3, "minimum": 0.0, "maximum": 1.0, "x-step": 0.05, "x-hot-reload": "preserve_state" },
      "person_min_width": { "type": "integer", "title": "未匹配安全帽的人员框最小宽度", "default": 40, "minimum": 0, "maximum": 640, "x-unit": "像素", "x-step": 1, "x-hot-reload": "reset_state", "description": "人员框的水平宽度，使用固定640×640业务画布坐标，与原图或模型输入尺寸无关。综合模式中未匹配裸头和安全帽时，宽度和高度必须同时达到各自阈值才参与违规确认，任一小于阈值均计为待判断。等于阈值有效；0仅关闭宽度过滤。匹配到裸头始终绕过大小过滤。" },
      "person_min_height": { "type": "integer", "title": "未匹配安全帽的人员框最小高度", "default": 40, "minimum": 0, "maximum": 640, "x-unit": "像素", "x-step": 1, "x-hot-reload": "reset_state", "description": "人员框的垂直高度，使用固定640×640业务画布坐标。综合模式中未匹配裸头和安全帽时，宽度和高度必须同时达到各自阈值才参与违规确认，任一小于阈值均计为待判断。等于阈值有效；0仅关闭高度过滤，宽高都设为0关闭大小过滤。匹配到裸头始终绕过大小过滤。" },
      "helmet_min_score": { "type": "number", "title": "安全帽最低置信度", "default": 0.3, "minimum": 0.0, "maximum": 1.0, "x-step": 0.05, "x-hot-reload": "preserve_state" },
      "bare_head_min_score": { "type": "number", "title": "未戴帽头部最低置信度", "default": 0.3, "minimum": 0.0, "maximum": 1.0, "x-step": 0.05, "x-hot-reload": "preserve_state" },
      "confirm_sec": { "type": "number", "title": "违规确认时间", "default": 0.5, "minimum": 0.0, "maximum": 30.0, "x-unit": "秒", "x-step": 0.1, "x-hot-reload": "preserve_state" },
      "clear_sec": { "type": "number", "title": "告警解除时间", "default": 1.0, "minimum": 0.0, "maximum": 30.0, "x-unit": "秒", "x-step": 0.1, "x-hot-reload": "preserve_state" }
    }
  },
  "outputs": [
    { "key": "helmet_roi_available", "type": "boolean", "label": "安全帽ROI是否有效" },
    { "key": "helmet_alarm", "type": "boolean", "label": "未戴安全帽告警" },
    { "key": "helmet_person_count", "type": "integer", "label": "装卸区域人员数" },
    { "key": "unhelmeted_count", "type": "integer", "label": "未戴安全帽人数" },
    { "key": "helmet_unknown_count", "type": "integer", "label": "头部状态无法判断的人员数" }
  ],
  "report_fields": [],
  "actions": [
    {
      "id": "switch_helmet_setting",
      "label": "切换安全帽参数",
      "style": "primary",
      "help": "在置信度和告警时间等核心参数之间循环切换。"
    },
    {
      "id": "helmet_setting_decrease",
      "label": "当前参数 -",
      "style": "default",
      "help": "减小画面中黄色显示的安全帽检测参数。"
    },
    {
      "id": "helmet_setting_increase",
      "label": "当前参数 +",
      "style": "default",
      "help": "增大画面中黄色显示的安全帽检测参数。"
    },
    {
      "id": "reset_helmet_alarm",
      "label": "复位安全帽告警",
      "style": "primary",
      "help": "清除当前安全帽违规确认和延迟解除状态。"
    }
  ]
}
