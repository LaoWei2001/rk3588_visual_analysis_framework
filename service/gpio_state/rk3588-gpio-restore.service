[Unit]
Description=Restore persistent RK3588 GPIO output states
DefaultDependencies=no
After=systemd-udev-trigger.service
Wants=rk3588-gpio-control.service
After=rk3588-gpio-control.service
Before=sysinit.target sound.target bootanim.service vision_app.service rk3588-console.service

[Service]
Type=oneshot
RuntimeDirectory=rk3588-gpio-persistence
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/touch /run/rk3588-gpio-persistence/enabled
# 视觉应用可能已占用某些 GPIO；这不能妨碍独立开启持久化功能。
# 恢复失败会写入日志，但服务仍保持开启，后续视觉应用输出会正常保存。
ExecStart=-/usr/local/bin/rk3588-gpioctl restore
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
