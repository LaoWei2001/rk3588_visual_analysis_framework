[Unit]
Description=RK3588 persistent real-time GPIO controller
DefaultDependencies=no
After=systemd-udev-trigger.service
Before=rk3588-gpio-restore.service sysinit.target sound.target bootanim.service vision_app.service rk3588-console.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/rk3588_gpio_control_daemon
Restart=always
RestartSec=1
RuntimeDirectory=rk3588-gpio-control
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
KillMode=control-group
TimeoutStopSec=3

[Install]
WantedBy=sysinit.target
